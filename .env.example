# ---- App ----
APP_ENV=development
APP_NAME=golang-staterpack
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=debug

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=app.events
RABBITMQ_PREFETCH=10

# ---- LLM (DeepSeek V4.1 Flash, OpenAI-compatible endpoint) ----
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60s

# ---- Reconciler ----
# Background sweep that rescues tasks stranded by a lost publish or a dead
# worker. RECONCILER_PENDING_GRACE must be >= RECONCILER_INTERVAL.
RECONCILER_ENABLED=true
RECONCILER_INTERVAL=1m
RECONCILER_PENDING_GRACE=5m
RECONCILER_PROCESSING_TIMEOUT=10m
RECONCILER_BATCH_SIZE=100

# How long the Redis duplicate-suppression marker is kept. Should comfortably
# exceed the longest retry window (MaxRetries at exponential backoff).
DEDUPE_TTL=24h

# ---- Observability ----
METRICS_ENABLED=true
